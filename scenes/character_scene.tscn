[gd_scene load_steps=2 format=3 uid="uid://bcharacterscene1"]

[ext_resource type="Script" path="res://scripts/character_controller.gd" id="1_ctrl"]

[node name="CharacterScene" type="Node2D"]
script = ExtResource("1_ctrl")

[node name="Character" type="Node2D" parent="."]

[node name="Sprite" type="AnimatedSprite2D" parent="Character"]

[node name="ClickZones" type="Node2D" parent="Character"]

[node name="HeadZone" type="Area2D" parent="Character/ClickZones"]

[node name="CollisionShape2D" type="CollisionShape2D" parent="Character/ClickZones/HeadZone"]

[node name="BodyZone" type="Area2D" parent="Character/ClickZones"]

[node name="CollisionShape2D" type="CollisionShape2D" parent="Character/ClickZones/BodyZone"]

[node name="LapZone" type="Area2D" parent="Character/ClickZones"]

[node name="CollisionShape2D" type="CollisionShape2D" parent="Character/ClickZones/LapZone"]

[node name="BlinkTimer" type="Timer" parent="."]
one_shot = true

[node name="UI" type="CanvasLayer" parent="."]

[node name="MenuButtons" type="VBoxContainer" parent="UI"]

[node name="PetButton" type="Button" parent="UI/MenuButtons"]
text = "Pet"

[node name="TalkButton" type="Button" parent="UI/MenuButtons"]
text = "Talk"

[node name="GiftButton" type="Button" parent="UI/MenuButtons"]
text = "Gift"

[connection signal="input_event" from="Character/ClickZones/HeadZone" to="." method="_on_head_zone_input_event"]
[connection signal="input_event" from="Character/ClickZones/BodyZone" to="." method="_on_body_zone_input_event"]
[connection signal="input_event" from="Character/ClickZones/LapZone" to="." method="_on_lap_zone_input_event"]
[connection signal="pressed" from="UI/MenuButtons/PetButton" to="." method="_on_pet_button_pressed"]
[connection signal="pressed" from="UI/MenuButtons/TalkButton" to="." method="_on_talk_button_pressed"]
[connection signal="pressed" from="UI/MenuButtons/GiftButton" to="." method="_on_gift_button_pressed"]
